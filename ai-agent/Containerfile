FROM docker.io/library/python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY main.py retrieval.py ./
RUN useradd --create-home --uid 10001 core
USER core
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=12s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=10)"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8090"]
